{
  "name": "@usecloud/core-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:budget": "npm run build && node scripts/check-bundle-budget.mjs",
    "analyze": "tsc -b && vite build --mode analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && node scripts/check-architecture.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --config ../../.prettierrc --write src stories tests .storybook",
    "format:check": "prettier --config ../../.prettierrc --check src stories tests .storybook",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:budget",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "visual:test": "playwright test",
    "visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@material-symbols/svg-400": "^0.47.6",
    "@material/material-color-utilities": "^0.4.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-toolbar": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "@usecloud/ui": "0.1.0",
    "@usecloud/theme": "0.1.0",
    "@usecloud/app-sdk": "0.1.0",
    "@usecloud/manifest": "0.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}

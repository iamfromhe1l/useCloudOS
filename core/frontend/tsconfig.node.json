{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "paths": { "@/*": ["./src/*"] },
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "@testing-library/jest-dom/vitest"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "stories/**/*.tsx",
    "tests/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}

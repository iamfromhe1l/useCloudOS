{
  "name": "usecloudos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "core/frontend",
    "apps/*/frontend",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @usecloud/theme && npm run build -w @usecloud/manifest && npm run build -w @usecloud/app-sdk && npm run build -w @usecloud/ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint core/frontend apps/*/frontend packages examples --max-warnings 0",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build -w @usecloud/theme && npm run build -w @usecloud/manifest && npm run build -w @usecloud/app-sdk && npm run build -w @usecloud/ui && npm run build -w @usecloud/containers && npm run build -w @usecloud/core-frontend",
    "build:shared": "npm run build -w @usecloud/theme && npm run build -w @usecloud/manifest && npm run build -w @usecloud/app-sdk && npm run build -w @usecloud/ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}

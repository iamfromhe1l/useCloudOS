#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=backend-common
source "${SCRIPT_DIR}/backend-common"

require_backend_vm
printf "Testing cloud-core in VM '%s'...\n" "${VM_NAME}"
limactl shell --workdir "${GUEST_BACKEND_DIR}" "${VM_NAME}" -- /usr/local/go/bin/go test ./...

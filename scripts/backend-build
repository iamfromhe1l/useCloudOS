#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=backend-common
source "${SCRIPT_DIR}/backend-common"

require_backend_vm
ldflags="$(build_ldflags)"

printf "Building Linux cloud-core in VM '%s'...\n" "${VM_NAME}"
limactl shell --workdir "${GUEST_BACKEND_DIR}" "${VM_NAME}" -- \
  /usr/local/go/bin/go build -trimpath -ldflags "${ldflags}" -o bin/cloud-core ./cmd/cloud-core
guest_arch="$(limactl shell --workdir / "${VM_NAME}" -- uname -m)"
printf 'Built core/backend/bin/cloud-core (Linux %s).\n' "${guest_arch}"

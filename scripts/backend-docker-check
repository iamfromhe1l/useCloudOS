#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=backend-common
source "${SCRIPT_DIR}/backend-common"

require_backend_vm
api_url="${CLOUD_CORE_URL:-http://127.0.0.1:8080}"

printf "Running Docker API smoke test in VM '%s' against %s...\n" "${VM_NAME}" "${api_url}"
limactl shell --workdir "${GUEST_REPO_ROOT}" "${VM_NAME}" -- \
  env "CLOUD_CORE_URL=${api_url}" bash scripts/docker-smoke-guest

#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/backend-common"
require_backend_vm
cd "${REPO_ROOT}"
npm run build:shared
npm run build -w @usecloud/files
limactl shell --workdir "${GUEST_REPO_ROOT}/apps/files/backend" "${VM_NAME}" -- /usr/local/go/bin/go build -trimpath -o bin/files-service ./cmd/files-service
